{
  "project": "TerraVision AI",
  "dataset": "EuroSAT RGB",
  "num_classes": 10,
  "class_names": [
    "AnnualCrop",
    "Forest",
    "HerbaceousVegetation",
    "Highway",
    "Industrial",
    "Pasture",
